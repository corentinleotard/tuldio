---
interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="bg-white rounded-2xl p-8 border border-black/5 hover:border-brand/20 transition-colors">
  <div class="w-12 h-12 bg-brand-lightest rounded-xl flex items-center justify-center text-2xl mb-5">
    {icon}
  </div>
  <h3 class="text-lg font-semibold text-text mb-2">{title}</h3>
  <p class="text-text-secondary leading-relaxed">{description}</p>
</div>
