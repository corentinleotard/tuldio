---
const navLinks = [
  { label: 'Fonctionnalités', href: '/#fonctionnalites' },
  { label: 'Tarifs', href: '/tarifs' },
  { label: 'À propos', href: '/a-propos' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-lg border-b border-black/5">
  <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
      <img src="/logo.svg" alt="Tuldio" class="h-7" />
    </a>

    <!-- Desktop nav -->
    <div class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm text-text-secondary hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
    </div>

    <div class="hidden md:flex items-center gap-3">
      <a
        href="https://app.tuldio.fr"
        class="text-sm text-text-secondary hover:text-text transition-colors"
      >
        Se connecter
      </a>
      <a
        href="https://app.tuldio.fr"
        class="bg-brand text-white text-sm font-medium px-5 py-2.5 rounded-full hover:bg-brand-light transition-colors"
      >
        Essai gratuit
      </a>
    </div>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 -mr-2 text-text"
      aria-label="Menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-black/5 bg-surface">
    <div class="px-6 py-4 flex flex-col gap-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-text-secondary hover:text-text transition-colors"
        >
          {link.label}
        </a>
      ))}
      <hr class="border-black/5" />
      <a href="https://app.tuldio.fr" class="text-text-secondary hover:text-text transition-colors">
        Se connecter
      </a>
      <a
        href="https://app.tuldio.fr"
        class="bg-brand text-white text-center font-medium px-5 py-2.5 rounded-full hover:bg-brand-light transition-colors"
      >
        Essai gratuit
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
