---
import Base from '../layouts/base.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Section from '../components/section.astro';
import CtaButton from '../components/cta-button.astro';
import FeatureCard from '../components/feature-card.astro';
import Testimonial from '../components/testimonial.astro';
import FaqItem from '../components/faq-item.astro';
---

<Base
  title="Tuldio · Devis et factures en quelques secondes"
  description="Créez vos devis et factures en quelques secondes. L'outil pensé pour les indépendants qui veulent passer moins de temps sur la paperasse et plus sur leur métier."
>
  <Header />

  <!-- Hero -->
  <section class="pt-32 pb-20 md:pt-44 md:pb-28 bg-surface overflow-hidden">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: copy -->
        <div class="text-center lg:text-left">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-text tracking-tight leading-tight">
            Tu lui dis, <span class="text-brand">c'est fait.</span>
          </h1>
          <p class="mt-6 text-lg md:text-xl text-text-secondary max-w-xl mx-auto lg:mx-0 leading-relaxed">
            Décrivez votre prestation. Tuldio s'occupe du devis, de la facture, et de l'envoi.
          </p>
          <div class="mt-10 flex flex-col sm:flex-row items-center lg:items-start justify-center lg:justify-start gap-4">
            <CtaButton size="lg">Essayer 14 jours gratuitement</CtaButton>
            <CtaButton variant="secondary" size="lg" href="/#fonctionnalites">Découvrir</CtaButton>
          </div>
          <p class="mt-4 text-sm text-text-secondary">14 jours gratuits. Sans carte bancaire.</p>
        </div>

        <!-- Right: chat mockup -->
        <div class="flex justify-center lg:justify-end">
          <div class="w-[340px] bg-white rounded-[2rem] shadow-2xl shadow-black/10 border border-black/5 overflow-hidden">
            <!-- Phone header -->
            <div class="bg-brand px-6 pt-4 pb-3">
              <div class="flex items-center justify-between text-white/70 text-xs mb-3">
                <span>9:41</span>
                <div class="flex gap-1.5 items-center">
                  <!-- Signal bars -->
                  <svg class="w-4 h-3" viewBox="0 0 20 14" fill="currentColor">
                    <rect x="0" y="10" width="3" height="4" rx="0.5" opacity="1"/>
                    <rect x="5" y="7" width="3" height="7" rx="0.5" opacity="1"/>
                    <rect x="10" y="4" width="3" height="10" rx="0.5" opacity="0.4"/>
                    <rect x="15" y="0" width="3" height="14" rx="0.5" opacity="0.4"/>
                  </svg>
                  <!-- Battery -->
                  <svg class="w-5 h-3" viewBox="0 0 25 12" fill="currentColor">
                    <rect x="0" y="0" width="21" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1"/>
                    <rect x="2" y="2" width="12" height="8" rx="1" opacity="1"/>
                    <rect x="22" y="3.5" width="2.5" height="5" rx="1" opacity="0.5"/>
                  </svg>
                </div>
              </div>
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                </div>
                <div>
                  <p class="text-white font-semibold text-sm">Tuldio</p>
                  <p class="text-white/60 text-xs">En ligne</p>
                </div>
              </div>
            </div>

            <!-- Chat body -->
            <div class="bg-[#F8F7F4] px-4 py-5 space-y-3 min-h-[320px]">

              <!-- User text message -->
              <div class="flex justify-end">
                <div class="bg-brand text-white px-4 py-2.5 max-w-[85%] text-sm" style="border-radius: 18px 18px 6px 18px">
                  Fais un devis pour Mme Dupont, pose carrelage 20m² à 45€/m²
                </div>
              </div>

              <!-- Tuldio response -->
              <div class="flex justify-start">
                <div class="max-w-[90%] space-y-2">
                  <div class="bg-white px-4 py-2.5 border border-black/[0.06] text-sm text-text" style="border-radius: 18px 18px 18px 6px">
                    Voici le devis :
                  </div>
                  <!-- Quote card -->
                  <div class="bg-white rounded-2xl border border-black/[0.06] overflow-hidden">
                    <div class="p-4 space-y-2">
                      <div class="flex items-center justify-between">
                        <p class="text-sm font-medium text-text">Devis 047</p>
                        <span class="text-[11px] bg-brand/10 text-brand px-2.5 py-0.5 rounded-full font-medium">Brouillon</span>
                      </div>
                      <p class="text-sm text-text-secondary">Mme Dupont</p>
                      <div class="space-y-1 pt-1">
                        <div class="flex justify-between text-sm">
                          <span class="text-text truncate pr-2">Pose carrelage</span>
                          <span class="font-medium text-text shrink-0">20m² × 45€</span>
                        </div>
                      </div>
                      <div class="border-t border-black/[0.06] pt-3 flex justify-between items-baseline">
                        <span class="text-sm text-text-secondary">Total TTC</span>
                        <span class="text-lg font-bold text-text">900,00 €</span>
                      </div>
                    </div>
                    <div class="px-4 pb-4 flex gap-2">
                      <span class="flex-1 text-xs font-medium border border-black/[0.06] text-text rounded-lg py-2 text-center">
                        Consulter
                      </span>
                      <span class="flex-1 text-xs font-medium bg-brand text-white rounded-lg py-2 text-center">
                        Envoyer
                      </span>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <!-- Chat input bar -->
            <div class="bg-white border-t border-black/[0.06] px-3 py-2.5">
              <div class="flex items-center gap-2 border border-black/[0.08] rounded-2xl px-4 py-2.5">
                <span class="flex-1 text-sm text-text-secondary">Ecrivez un message...</span>
                <!-- Mic button -->
                <div class="w-8 h-8 rounded-full flex items-center justify-center text-text-secondary/60">
                  <svg class="w-[18px] h-[18px]" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3zm-1 1.93c-3.94-.49-7-3.85-7-7.93h2c0 3.31 2.69 6 6 6s6-2.69 6-6h2c0 4.08-3.06 7.44-7 7.93V19h4v2H8v-2h4v-3.07z"/>
                  </svg>
                </div>
                <!-- Send button -->
                <div class="w-8 h-8 bg-brand rounded-full flex items-center justify-center opacity-30">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pain → Solution -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Votre métier, <span class="text-accent">pas la paperasse</span>
      </h2>
      <p class="mt-6 text-lg text-text-secondary leading-relaxed max-w-2xl mx-auto">
        Vous avez choisi votre métier pour le pratiquer, pas pour passer vos soirées sur des tableurs.
        Avec Tuldio, un message suffit pour créer un devis ou une facture.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="text-center">
        <div class="w-14 h-14 bg-red-50 rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="font-semibold text-text mb-2">Avant Tuldio</h3>
        <p class="text-text-secondary text-sm leading-relaxed">
          30 minutes pour un devis. Des modèles Word qui cassent. Des factures qu'on oublie d'envoyer.
        </p>
      </div>

      <div class="text-center flex items-center justify-center">
        <svg class="w-10 h-10 text-brand hidden md:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
        <svg class="w-10 h-10 text-brand md:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>

      <div class="text-center">
        <div class="w-14 h-14 bg-brand-lightest rounded-2xl flex items-center justify-center mx-auto mb-4">
          <svg class="w-7 h-7 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="font-semibold text-text mb-2">Avec Tuldio</h3>
        <p class="text-text-secondary text-sm leading-relaxed">
          Vous tapez "devis pour Mme Dupont, 3 séances à 45€". Le PDF est prêt.
        </p>
      </div>
    </div>
  </Section>

  <!-- Speed demo -->
  <Section>
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Un devis en <span class="text-brand">30 secondes</span>
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Pas de formulaire. Pas de menu. Vous parlez, c'est fait.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="relative">
        <div class="w-10 h-10 bg-brand text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">1</div>
        <h3 class="font-semibold text-text text-lg mb-2">Dites-le</h3>
        <p class="text-text-secondary leading-relaxed">
          "Fais un devis pour Mme Dupont, pose carrelage 20m² à 45€/m²"
        </p>
      </div>
      <div class="relative">
        <div class="w-10 h-10 bg-brand text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">2</div>
        <h3 class="font-semibold text-text text-lg mb-2">Vérifiez</h3>
        <p class="text-text-secondary leading-relaxed">
          Le document est prêt avec les bonnes infos. Un coup d'œil, un ajustement si besoin.
        </p>
      </div>
      <div class="relative">
        <div class="w-10 h-10 bg-brand text-white rounded-full flex items-center justify-center font-bold text-lg mb-4">3</div>
        <h3 class="font-semibold text-text text-lg mb-2">Envoyez</h3>
        <p class="text-text-secondary leading-relaxed">
          Un PDF propre part par email à votre client. C'est fait.
        </p>
      </div>
    </div>
  </Section>

  <!-- Features -->
  <Section id="fonctionnalites" bg="white">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Tout ce qu'il faut, rien de plus
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Les outils essentiels pour gérer votre activité au quotidien.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <FeatureCard
        icon="📄"
        title="Devis"
        description="Décrivez votre prestation en quelques mots. Tuldio génère un devis propre avec vos prix mémorisés."
      />
      <FeatureCard
        icon="🧾"
        title="Factures"
        description="Transformez un devis en facture en un clic. Numérotation automatique, mise en page pro."
      />
      <FeatureCard
        icon="👥"
        title="Carnet de clients"
        description="Toutes les infos de vos clients au même endroit. Coordonnées, historique, notes. Fini les bouts de papier."
      />
      <FeatureCard
        icon="📊"
        title="Statistiques"
        description="Votre chiffre d'affaires, vos impayés, votre activité du mois. Tout en un coup d'œil."
      />
      <FeatureCard
        icon="📎"
        title="PDF professionnel"
        description="Des documents bien présentés avec vos infos, votre logo. Prêts à envoyer par email."
      />
      <FeatureCard
        icon="📱"
        title="Sur téléphone"
        description="Créez un devis depuis votre téléphone, entre deux rendez-vous ou sur le terrain."
      />
    </div>
  </Section>

  <!-- Client notebook -->
  <Section>
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Votre carnet de clients, toujours à jour
      </h2>
      <p class="mt-4 text-lg text-text-secondary max-w-2xl mx-auto">
        Plus besoin de chercher un numéro dans vos messages ou une adresse sur un post-it.
        Tout est au même endroit.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      <div class="bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 bg-brand-lightest rounded-xl flex items-center justify-center text-2xl mb-5">📇</div>
        <h3 class="text-lg font-semibold text-text mb-2">Tout centralisé</h3>
        <p class="text-text-secondary leading-relaxed">
          Nom, téléphone, email, adresse. Chaque client a sa fiche, accessible en une seconde.
        </p>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 bg-brand-lightest rounded-xl flex items-center justify-center text-2xl mb-5">📝</div>
        <h3 class="text-lg font-semibold text-text mb-2">Notes et historique</h3>
        <p class="text-text-secondary leading-relaxed">
          "Préfère le mardi matin", "clé sous le pot de fleurs". Ajoutez des notes, retrouvez-les plus tard.
        </p>
      </div>
      <div class="bg-white rounded-2xl p-8 border border-black/5">
        <div class="w-12 h-12 bg-brand-lightest rounded-xl flex items-center justify-center text-2xl mb-5">📂</div>
        <h3 class="text-lg font-semibold text-text mb-2">Devis et factures liés</h3>
        <p class="text-text-secondary leading-relaxed">
          Retrouvez tous les documents d'un client en un clic. Plus de recherche dans vos dossiers.
        </p>
      </div>
    </div>
  </Section>

  <!-- Social proof -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Ils l'utilisent au quotidien
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <Testimonial
        quote="Avant je faisais mes devis sur Word, ça me prenait une demi-heure. Maintenant c'est plié en 30 secondes."
        name="Marc D."
        role="Plombier"
      />
      <Testimonial
        quote="J'envoie mes factures depuis mon téléphone entre deux patients. Ça change la vie."
        name="Sophie L."
        role="Ostéopathe"
      />
      <Testimonial
        quote="Je suis nul en informatique et j'ai compris en 2 minutes. Y'a rien à apprendre, tu parles et c'est fait."
        name="Thomas R."
        role="Électricien"
      />
    </div>
  </Section>

  <!-- Pricing teaser -->
  <Section>
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight">
        Un prix simple
      </h2>
      <p class="mt-4 text-lg text-text-secondary">
        Pas de surprise, pas d'option cachée.
      </p>

      <div class="mt-10 bg-white rounded-2xl border border-black/5 p-8 md:p-10">
        <p class="text-text-secondary text-sm font-medium uppercase tracking-wide mb-2">Tout inclus</p>
        <div class="flex items-baseline justify-center gap-1">
          <span class="text-5xl font-bold text-text">29€</span>
          <span class="text-text-secondary text-lg">TTC /mois</span>
        </div>
        <p class="text-text-secondary mt-1">par utilisateur</p>
        <p class="text-brand font-medium text-sm mt-1">14 jours d'essai gratuit</p>

        <ul class="mt-8 space-y-3 text-left max-w-sm mx-auto">
          {[
            'Devis et factures illimités',
            'Carnet de clients',
            'Statistiques d\'activité',
            'Application mobile',
            'Export PDF professionnel',
          ].map((feature) => (
            <li class="flex items-center gap-3 text-text">
              <svg class="w-5 h-5 text-brand flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>{feature}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8">
          <CtaButton size="lg">Essayer 14 jours gratuitement</CtaButton>
        </div>
        <p class="text-sm text-text-secondary mt-3">Sans carte bancaire</p>
      </div>
    </div>
  </Section>

  <!-- FAQ -->
  <Section bg="white">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-text tracking-tight text-center mb-12">
        Questions fréquentes
      </h2>

      <div>
        <FaqItem
          question="Est-ce que Tuldio remplace mon comptable ?"
          answer="Non. Tuldio met en forme vos devis et factures à partir des informations que vous donnez. Les mentions habituelles sont pré-remplies pour vous faire gagner du temps, mais vous restez responsable de ce que contiennent vos documents. Pour les questions fiscales, voyez avec votre comptable."
        />
        <FaqItem
          question="Qu'est-ce que ça veut dire « comme un message » ?"
          answer="Vous écrivez ce que vous voulez dans une conversation, comme si vous parliez à quelqu'un. Par exemple : « fais un devis pour Mme Martin, 2h de consultation à 60€ ». Tuldio comprend et génère le document. Pas de formulaire, pas de case à cocher."
        />
        <FaqItem
          question="Est-ce que ça marche sur téléphone ?"
          answer="Oui. Tuldio fonctionne sur mobile, tablette et ordinateur. Vous pouvez créer un devis depuis votre téléphone entre deux rendez-vous."
        />
        <FaqItem
          question="Je ne suis pas à l'aise avec l'informatique, c'est pour moi ?"
          answer="C'est justement pour vous. Si vous savez dicter un message vocal, vous savez utiliser Tuldio. Pas de menu compliqué, pas de formulaire. Vous parlez, le document est prêt."
        />
        <FaqItem
          question="Mes données sont en sécurité ?"
          answer="Vos données sont stockées sur des serveurs en Europe. Elles vous appartiennent, elles ne sont jamais partagées ni vendues."
        />
        <FaqItem
          question="Comment je contacte le support ?"
          answer="Par email à support@tuldio.fr. On répond sous 24h, souvent bien plus vite."
        />
      </div>
    </div>
  </Section>

  <!-- Final CTA -->
  <Section bg="brand">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white tracking-tight">
        Prêt à gagner du temps ?
      </h2>
      <p class="mt-4 text-lg text-white/70">
        Rejoignez les indépendants qui ont simplifié leur paperasse.
      </p>
      <div class="mt-8">
        <CtaButton variant="white" size="lg">Essayer 14 jours gratuitement</CtaButton>
      </div>
      <p class="mt-4 text-sm text-white/50">14 jours gratuits. Sans carte bancaire.</p>
    </div>
  </Section>

  <Footer />
</Base>
