---
import Base from '../layouts/base.astro';
import Header from '../components/header.astro';
import Footer from '../components/footer.astro';
import Section from '../components/section.astro';
import CtaButton from '../components/cta-button.astro';
---

<Base
  title="Tarifs · Tuldio"
  description="49€/mois par utilisateur, tout inclus. 14 jours d'essai gratuit, sans carte bancaire."
>
  <Header />

  <section class="pt-32 pb-20 md:pt-44 md:pb-28 bg-surface">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-text tracking-tight">
          Un prix simple
        </h1>
        <p class="mt-6 text-lg text-text-secondary max-w-2xl mx-auto">
          Pas de plan compliqué. Pas d'option cachée. Tout est inclus.
        </p>
      </div>

      <div class="mt-16 max-w-lg mx-auto">
        <div class="bg-white rounded-2xl border border-black/5 p-8 md:p-10 shadow-sm">
          <p class="text-brand text-sm font-semibold uppercase tracking-wide mb-4">Tout inclus</p>
          <div class="flex items-baseline gap-1">
            <span class="text-5xl font-bold text-text">49€</span>
            <span class="text-text-secondary text-lg">/mois</span>
          </div>
          <p class="text-text-secondary mt-2 mb-1">par utilisateur</p>
          <p class="text-brand font-medium text-sm mb-8">14 jours d'essai gratuit</p>

          <ul class="space-y-4">
            {[
              'Devis et factures illimités',
              'Carnet de clients avec notes',
              'Statistiques d\'activité',
              'Application mobile',
              'PDF professionnels avec votre logo',
              'Envoi par email en un clic',
              'Vos prix et clients mémorisés',
              'Support par email',
            ].map((feature) => (
              <li class="flex items-start gap-3 text-text">
                <svg class="w-5 h-5 text-brand flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>{feature}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8">
            <CtaButton size="lg" class="w-full">Essayer 14 jours gratuitement</CtaButton>
          </div>
          <p class="text-center text-sm text-text-secondary mt-3">Sans carte bancaire. Résiliation en un clic.</p>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Base>
