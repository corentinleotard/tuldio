{
  "name": "tuldio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web,crons -c blue,green,yellow \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:crons\"",
    "dev:api": "pnpm --filter @tuldio/api dev",
    "dev:web": "pnpm --filter @tuldio/web dev",
    "dev:crons": "pnpm --filter @tuldio/crons dev",
    "dev:website": "pnpm --filter @tuldio/website dev",
    "build:website": "pnpm --filter @tuldio/website build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p packages/common --noEmit && tsc -p packages/core --noEmit && tsc -p apps/api --noEmit && tsc -p apps/web --noEmit && tsc -p apps/crons --noEmit",
    "test": "vitest",
    "eval": "ANTHROPIC_API_KEY=$(grep ANTHROPIC_API_KEY .env | cut -d= -f2) vitest run --reporter=verbose --config vitest.eval.config.ts",
    "db:migrate": "pnpm --filter @tuldio/api exec tsx --env-file=.env ../../packages/core/src/lib/database/migrate.ts",
    "db:test:setup": "pnpm --filter @tuldio/api exec tsx ../../packages/core/src/lib/database/setup-test-db.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@types/pg": "^8.18.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "exceljs": "^4.4.0",
    "globals": "^17.4.0",
    "pg": "^8.19.0",
    "playwright": "^1.58.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "zod": "^3.23.0"
  }
}
